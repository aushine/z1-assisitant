# API 基础路径（默认走 Vite proxy /z1 -> 后端；/z1 服务前缀防 nginx 撞名，D-03 第十三轮）
VITE_API_BASE=/z1/api/v1

# 开发服务器端口
VITE_PORT=5174

# 开发环境 Vite proxy 目标
VITE_API_PROXY_TARGET=http://localhost:8090

# （可选）上传静态 /z1/uploads/ 单独代理目标；不填 = 同 VITE_API_PROXY_TARGET。
# 一般不用填：图片地址改由后端 storage.public_url 下发（见 utils/avatar.ts）

# 应用标题
VITE_APP_TITLE=生活助手
