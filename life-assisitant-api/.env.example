# 生活助手后端 - 环境变量样例
# 复制为 .env 后填入实际值（GoFrame 默认从 manifest/config/config.yaml 读取，不依赖 .env）
# 此文件仅作开发参考

# ====== HTTP 服务 ======
GF_SERVER_ADDRESS=:8080
GF_SERVER_READTIMEOUT=30s
GF_SERVER_WRITETIMEOUT=30s

# ====== MySQL ======
# 默认与 ../life-assisitant/docker-compose.dev.yml 一致
GF_DATABASE_DEFAULT_LINK=mysql:root:root123@tcp(127.0.0.1:3306)/life_assistant?charset=utf8mb4&parseTime=true&loc=Local

# ====== Redis ======
GF_REDIS_DEFAULT_ADDRESS=127.0.0.1:6379
GF_REDIS_DEFAULT_DB=0
GF_REDIS_DEFAULT_PASSWORD=

# ====== JWT ======
# 生产环境必须用强随机字符串（至少 32 字节）
GF_JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
GF_JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
GF_JWT_ACCESS_TTL=900
GF_JWT_REFRESH_TTL=604800
GF_JWT_ISSUER=life-assistant
